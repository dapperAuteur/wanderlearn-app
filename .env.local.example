# ==============================================================================
# Wanderlust — environment variables
#
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# ── WHICH DATABASE IS THIS? ─────────────────────────────────────────────────
# Required before any dev-shaped database command will run: db:migrate,
# db:seed, db:push, db:promote, db:studio. All of them load THIS file and
# write to whatever DATABASE_URL below points at.
#
# That is not hypothetical. On 2026-08-20 this file was found pointing at
# production, which meant `pnpm db:seed` would have inserted demo content into
# the live database and `pnpm db:push` could have dropped a column off it.
#
# scripts/guard-db-target.ts fails CLOSED: leave this unset and dev commands
# refuse rather than guess.
#
#   DB_ENV=development   a scratch database. Safe to migrate, seed, reset.
#   DB_ENV=production    the live database. Dev commands refuse.
#
# If you are not sure, assume production and check. A Neon branch makes a real
# dev database cheap, and is the actual fix rather than the label.
DB_ENV=production
# See docs/NEON_SETUP.md for step-by-step provisioning instructions.
# ==============================================================================

# ---- Next.js / app ----------------------------------------------------------
# Do NOT set NODE_ENV yourself. Next.js and Vercel set it automatically
# (development in dev, production in build/prod). Overriding it triggers
# the "non-standard NODE_ENV" warning and breaks some internals.
NEXT_PUBLIC_APP_NAME=Wanderlust
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ---- Database (Neon Postgres) -----------------------------------------------
# Create a project at https://neon.tech and copy the pooled connection string.
# Format: postgres://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# ---- Better Auth ------------------------------------------------------------
# BETTER_AUTH_SECRET: a 32+ character random string. Generate one with:
#   openssl rand -base64 48
# BETTER_AUTH_URL: the public base URL of the app (no trailing slash).
# For passkeys to work in production, this must be HTTPS and match the
# domain the browser sees.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# ---- Sign in with WitUS (ecosystem OIDC SSO) --------------------------------
# Optional. The "Sign in with WitUS" button + OIDC provider stay OFF until
# WITUS_OIDC_CLIENT_ID is set, so leaving these blank never breaks the build or
# the existing sign-in methods. Provision the client pair on the IdP at
# accounts.witus.online. The redirect URI the IdP must whitelist is:
#   {BETTER_AUTH_URL}/api/auth/oauth2/callback/witus
# WITUS_OIDC_DISCOVERY_URL defaults to the accounts.witus.online well-known URL.
#
# Setting the client id also turns on two ecosystem behaviours, both dark without it:
#   * the sign-in page's silent "Continue as <name>" check, which asks
#     {IdP origin}/api/ecosystem/session over CORS in parallel with the form. A blocked or
#     timed-out probe is invisible by design (Safari ITP and Firefox TCP answer nothing).
#   * GLOBAL sign-out: signing out here also ends the shared IdP session, so it signs you out
#     of every WitUS app in the browser. The IdP must have this app's origin registered as a
#     post_logout_redirect_uri (registered as `<origin>/`, trailing slash included) or it
#     refuses the return trip. You are still signed out here either way.
WITUS_OIDC_CLIENT_ID=
WITUS_OIDC_CLIENT_SECRET=
# WITUS_OIDC_DISCOVERY_URL=https://accounts.witus.online/api/idp/.well-known/openid-configuration

# ---- Email (Mailgun) --------------------------------------------------------
# Required in production for magic-link and email-OTP sign-in. In development,
# if unset, email bodies are logged to the server console (see src/lib/mailer.ts).
# Create and verify a sending domain at https://www.mailgun.com
MAILGUN_API_KEY=
MAILGUN_DOMAIN=witus.online
# Leave MAILGUN_REGION unset for US accounts. Set it to "eu" only if your
# Mailgun account is in the EU region.
# MAILGUN_REGION=us
# EMAIL_FROM must be a verified sender on your Mailgun domain.
# Example: "Wanderlust <noreply@witus.online>" or bare noreply@witus.online
EMAIL_FROM=noreply@domain.com

# ---- Admin ------------------------------------------------------------------
# Email address that receives support-chat notifications (week 11+).
ADMIN_NOTIFY_EMAIL=

# ---- PostHog analytics (shared WitUS project) -------------------------------
# Both values are publishable and ship in the browser bundle; the phc_ project
# token is not a secret. Capture stays entirely off until the token is set, so
# leaving these blank is a supported state for local dev and previews.
#
# SET THE HOST EXPLICITLY. The WitUS project is US-hosted. Pointing the SDK at the
# wrong region does not error -- PostHog accepts the request and the events land
# nowhere you can see them, which presents as "analytics is broken" with nothing
# to debug.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Error monitoring (Better Stack, over the Sentry protocol) ---------------
# Better Stack ingests Sentry-protocol events, so the client is @sentry/nextjs and
# these are Better Stack SOURCE DSNs. Leaving them blank is a supported state: the
# SDK is only initialised when a DSN is present, so with no value nothing is
# collected and no request leaves the app.
#
# TWO DSNs ON PURPOSE. SENTRY_DSN covers the server and edge runtimes and stays
# server-side. NEXT_PUBLIC_SENTRY_DSN is inlined into the browser bundle and is
# therefore public by construction -- use a separate Better Stack source for it so
# a flood of browser noise can be throttled or rotated without touching the server
# source.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional label on every event. Defaults to VERCEL_ENV, then NODE_ENV.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Build-time only, read by the Sentry plugin in next.config.ts to upload source
# maps. Without the auth token the upload is skipped and you get minified stack
# traces -- a degraded report, never a failed build. Never commit the token.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
